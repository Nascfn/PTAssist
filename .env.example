# Copy to .env for local development. Never commit .env.
# Frontend variables live in frontend/.env.example.

# Database (Postgres in Docker Compose). "+psycopg" selects the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://ptassist:ptassist@localhost:5432/ptassist

# Clerk (get values from the team, never paste them in code)
CLERK_SECRET_KEY=
CLERK_ISSUER=

# Storage (MinIO in Docker Compose)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=videos

# AI service
AI_SERVICE_URL=http://localhost:8001
