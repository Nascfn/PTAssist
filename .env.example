# Copy to .env for local development. Never commit .env.
# Frontend variables live in frontend/.env.example.

# Database (Postgres in Docker Compose). "+psycopg" selects the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://ptassist:ptassist@localhost:5432/ptassist
# Backend tests only: a separate database that every test run wipes (see backend/README.md).
TEST_DATABASE_URL=postgresql+psycopg://ptassist:ptassist@localhost:5433/ptassist_test

# Clerk (get values from the team, never paste them in code)
# Secret key (sk_test_...). The API uses it to check tokens and look up new users' emails.
CLERK_SECRET_KEY=
# Web app origins allowed to call the API, comma-separated. Tokens from other origins get 401.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# Storage (MinIO in Docker Compose)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=videos

# AI service
AI_SERVICE_URL=http://localhost:8001
